# 1. Seguridad de Django
DJANGO_SECRET_KEY=generar-clave-segura-aleatoria-con-caracteres-especiales
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,eztechlabs.com,www.eztechlabs.com

# 2. Base de Datos PostgreSQL (Producción)
